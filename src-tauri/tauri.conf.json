{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "workTrace",
  "version": "0.1.3",
  "identifier": "com.qwnull.worktrace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "工作日迹 WorkTrace",
        "width": 1160,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyMDJDNUMyNzM3NkU5NEMKUldSTTZYWnp3c1VDRXFBUWtKVHgwTzlrc3kyWGluOG9JU2s3R1Z2VnJ0dTRzR0hxaHhZbXVTVlUK",
      "endpoints": [
        "https://github.com/qw-null/workTrace/releases/latest/download/latest.json"
      ]
    }
  }
}
